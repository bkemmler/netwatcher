[Unit]
Description=Netwatcher arp discovery scan (one-shot)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=__NETWATCHER_DIR__
Environment="NETWATCHER_DB=__NETWATCHER_DB__"
Environment="NETWATCHER_CACHE_DIR=__NETWATCHER_DB_DIR__/cache"
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=__NETWATCHER_BIN__ scan

# arp-scan needs CAP_NET_RAW; this short-lived unit therefore runs as root.
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=__NETWATCHER_DB_DIR__ __NETWATCHER_DB_DIR__/cache
PrivateTmp=true
