[Unit]
Description=Netwatcher nmap detail scan (one-shot)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=__NETWATCHER_DIR__
Environment="NETWATCHER_DB=__NETWATCHER_DB__"
Environment="NETWATCHER_CACHE_DIR=__NETWATCHER_DB_DIR__/cache"
Environment="NETWATCHER_REMOTE_INTEGRATIONS=__NETWATCHER_REMOTE_INTEGRATIONS__"
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=__NETWATCHER_BIN__ detail-scan

# nmap OS detection needs elevated network privileges.
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=__NETWATCHER_DB_DIR__ __NETWATCHER_DB_DIR__/cache
PrivateTmp=true
